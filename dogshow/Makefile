# dogshow developer entrypoints. `uv run` resolves the editable sibling
# packages from pyproject.toml, so every target runs against the live tree.
.PHONY: test report coverage erd serve showcase clean

# the full self-contained suite (the ssh backend skips without DOGSHOW_SSH_REMOTE)
test:
	uv run pytest

# run the suite under coverage and (re)generate REPORT.md — the single source of
# truth for runtime + per-library coverage — plus the browsable HTML report.
# Subprocess workers are measured (sitecustomize.py + pyproject [tool.coverage]).
report:
	uv run python report.py
	@echo "report: REPORT.md + coverage/html/index.html"

coverage: report   # alias

# regenerate the committed ER diagram from src/meta.py (guarded by test_docs.py)
erd:
	uv run dz draw --out docs/schema.md

# the showcase as a user drives it, in one bounded command: boots the site +
# relay, runs the real `dz` CLI loop, tears the site down. The outer `timeout` is
# the last-ditch backstop on top of showcase.py's own per-command process-group
# kills, so this target can never wedge.
showcase:
	timeout --kill-after=15 180 uv run python showcase.py

# serve the federation site long-lived for fully manual hand-driving (open it in
# a browser, run ad-hoc `dz` commands in another shell); see tests/site/__main__.py
serve:
	uv run python -m tests.site

# wipe run artifacts; REPORT.md is tracked (regenerated by `make report`), so it
# is restored with `git checkout -- REPORT.md` rather than deleted here.
clean:
	rm -rf data _remote _depot _cache .datazimmer schemas erd.md coverage .coverage* *.db
